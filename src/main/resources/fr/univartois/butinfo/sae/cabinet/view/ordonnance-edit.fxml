<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" style="-fx-padding: 30;" prefWidth="500.0" prefHeight="400.0" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="fr.univartois.butinfo.sae.cabinet.controller.OrdonnanceEditController">
    
    <Label text="Nouvelle Ordonnance" styleClass="header-label"/>
    
    <GridPane vgap="15" hgap="15" VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints minWidth="120"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        
        <Label text="Patient :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="patientComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" maxWidth="Infinity"/>
        
        <Label text="Médecin :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="medecinComboBox" GridPane.rowIndex="1" GridPane.columnIndex="1" maxWidth="Infinity"/>
        
        <Label text="Date validité :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <DatePicker fx:id="datePicker" GridPane.rowIndex="2" GridPane.columnIndex="1" maxWidth="Infinity"/>
        
        <Label text="Remarques :" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="remarquesField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>
    
    <HBox spacing="15" style="-fx-alignment: center-right;">
        <Button text="Annuler" styleClass="button-secondary"/>
        <Button text="Créer"/>
    </HBox>
</VBox>
