<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" style="-fx-padding: 30;" prefWidth="500.0" prefHeight="500.0" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="fr.univartois.butinfo.sae.cabinet.controller.PatientEditController">
    
    <Label text="Édition du Patient" styleClass="header-label"/>
    
    <GridPane vgap="15" hgap="15" VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints minWidth="120"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        
        <Label text="Nom :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nomField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        
        <Label text="Prénom :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="prenomField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        
        <Label text="Téléphone :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="telephoneField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        
        <Label text="Email :" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="emailField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        
        <Label text="Adresse :" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="adresseField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        
        <Label text="Date de naissance :" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <DatePicker fx:id="naissancePicker" GridPane.rowIndex="5" GridPane.columnIndex="1" maxWidth="Infinity"/>
        
        <Label text="Numéro Sécu :" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="secuField" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
        
        <Label text="Taux Remb. :" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <TextField fx:id="tauxField" GridPane.rowIndex="7" GridPane.columnIndex="1" text="0.75"/>
    </GridPane>
    
    <HBox spacing="15" style="-fx-alignment: center-right;">
        <Button text="Annuler" styleClass="button-secondary"/>
        <Button text="Enregistrer"/>
    </HBox>
</VBox>
