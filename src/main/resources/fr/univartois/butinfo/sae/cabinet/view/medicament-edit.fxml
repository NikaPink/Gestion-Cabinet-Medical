<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" style="-fx-padding: 30;" prefWidth="500.0" prefHeight="300.0" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="fr.univartois.butinfo.sae.cabinet.controller.MedicamentEditController">
    
    <Label text="Ajout d'un Médicament" styleClass="header-label"/>
    
    <GridPane vgap="15" hgap="15" VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints minWidth="120"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        
        <Label text="Nom :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nomField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        
        <Label text="Principe actif :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="principeField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        
        <Label text="Prix moyen :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="prixField" GridPane.rowIndex="2" GridPane.columnIndex="1" text="10.0"/>
    </GridPane>
    
    <HBox spacing="15" style="-fx-alignment: center-right;">
        <Button onAction="#handleCancel" text="Annuler" styleClass="button-secondary"/>
        <Button onAction="#handleOk" text="Ajouter"/>
    </HBox>
</VBox>
