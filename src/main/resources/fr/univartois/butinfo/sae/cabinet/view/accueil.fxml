<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0" spacing="20.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.univartois.butinfo.sae.cabinet.controller.AccueilController">
    
    <Label styleClass="header-label" text="Gestion du Cabinet Médical" />
    <Label styleClass="subheader-label" text="Sélectionnez un module pour commencer" />
    
    <VBox spacing="10.0" style="-fx-alignment: center;">
        <Button onAction="#patient" prefWidth="250.0" text="Gestion des Patients" />
        <Button onAction="#medecin" prefWidth="250.0" text="Gestion des Médecins" />
        <Button onAction="#rdv" prefWidth="250.0" text="Gestion des Rendez-vous" />
        <Button onAction="#medicament" prefWidth="250.0" text="Gestion des Médicaments" />
        <Button onAction="#ordonnance" prefWidth="250.0" text="Gestion des Ordonnances" />
    </VBox>
    
</VBox>
